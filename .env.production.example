# ============================================
# ENV PRODUCTION — https://compscience.uniwara.ac.id
# Copy → .env di hosting, isi yang bertanda [ISI] / [KOSONGKAN]
# Dibuat 2026-08-23 Fase 1 lock
# ============================================

APP_NAME="S1 Ilmu Komputer UNIWARA"
APP_ENV=production
APP_KEY=[ISI — jalankan: php artisan key:generate --show]
APP_DEBUG=false
APP_URL=https://compscience.uniwara.ac.id
APP_TIMEZONE=Asia/Jakarta

# SEO Fase 1 — sudah lock, ganti jika mau
SEO_TITLE="S1 Ilmu Komputer UNIWARA Pasuruan | Biaya Kuliah & Pendaftaran"
SEO_DESCRIPTION="Daftar kuliah S1 Ilmu Komputer di Universitas PGRI Wiranegara Pasuruan. Kurikulum AI, rekayasa perangkat lunak, biaya terjangkau & prospek karier global."
# GA4_ID Fase 3 — kosongkan jika belum punya, isi kalau sudah ada G-XXXX
GA4_ID=

# Akun admin awal (hanya saat fresh migrate --seed)
INITIAL_ADMIN_NAME="Administrator Prodi"
INITIAL_ADMIN_EMAIL=[ISI — email admin, ex: admin@uniwara.ac.id]
INITIAL_ADMIN_PASSWORD=[ISI — password kuat, min 8 char]

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database MySQL InnoDB utf8mb4_unicode_ci
DB_CONNECTION=mysql
DB_HOST=[ISI — host MySQL hosting, ex: localhost atau 127.0.0.1]
DB_PORT=3306
DB_DATABASE=[ISI — nama DB, ex: uniwara_compscience]
DB_USERNAME=[ISI — user DB hosting]
DB_PASSWORD=[ISI — password DB hosting]
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=compscience.uniwara.ac.id

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

# Redis / Memcached — KOSONGKAN jika tidak pakai (sudah file)
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — ISI jika mau kirim email, KOSONGKAN jika pakai log saja
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=[KOSONGKAN — atau smtp.hosting, ex: mail.compscience.uniwara.ac.id]
MAIL_PORT=587
MAIL_USERNAME=[KOSONGKAN]
MAIL_PASSWORD=[KOSONGKAN]
MAIL_FROM_ADDRESS="noreply@compscience.uniwara.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 — KOSONGKAN jika tidak pakai
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================
# CATATAN DEPLOY — jalankan setelah upload & isi DB:
# 1. php artisan key:generate --force (jika APP_KEY masih [ISI])
# 2. php artisan migrate --force
# 3. php artisan db:seed --force (jika fresh)
# 4. php artisan storage:link
# 5. npm run build
# 6. php artisan optimize
# 7. cek: curl -I https://compscience.uniwara.ac.id/sitemap.xml
# ============================================
